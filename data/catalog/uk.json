  "programs": [
    {
      "id": "sheffield-computer-science-bsc",
      "university_id": "sheffield",
      "name": "计算机科学",
      "name_en": "Computer Science BSc",
      "degree": "本科",
      "subject": "计算机",
      "intake": "2027",
      "duration": "3 年",
      "entry_summary": "高考有直入路径；A-level A*AA / AAA，须满足数学等选科",
      "tuition_summary": "2027 专业金额本次未取得",
      "outcomes_summary": "2022/23届：60% 工作或升学 · 本课程 · 毕业后 15 个月",
      "sections": {
        "overview": [
          {
            "label": "课程与学制",
            "text": "2027 年 9 月入学，UCAS G402，BSc，全日制 3 年；另加实习或海外学习年会改变总时长。",
            "source_ids": [
              "UK-SHE-CS-COURSE"
            ]
          },
          {
            "label": "学什么",
            "text": "兼顾计算机理论与软件实践，涉及网络安全、深度学习、语音识别、密码学和机器人。",
            "source_ids": [
              "UK-SHE-CS-COURSE"
            ]
          }
        ],
        "admissions": [
          {
            "label": "大陆普高／高考",
            "text": "学校接受高考直入：AAA 及以上课程的校级总分要求为满分的至少 75%，还须满足专业先修单科要求。此规则未单列 2027 年；具体高考选科组合及本课程换算需向学校确认。仅有高中毕业证需认可预科。",
            "source_ids": [
              "UK-SHE-CHINA",
              "UK-SHE-CS-COURSE"
            ]
          },
          {
            "label": "A-level 资格",
            "text": "2027 标准要求为 A*AA（含数学），或 AAA（含数学和计算机科学）；这两条是不同的资格组合。",
            "source_ids": [
              "UK-SHE-CS-COURSE"
            ]
          },
          {
            "label": "英语",
            "text": "IELTS 总分 6.5，各单项不低于 6.0；学校也接受列明的其他等效英语资格。",
            "source_ids": [
              "UK-SHE-CS-COURSE"
            ]
          }
        ],
        "fees": [
          {
            "label": "2027 国际生专业学费",
            "text": "本次未从官方收费工具取得 G402 的准确金额。查询入口可以访问，但费用数据返回空结果；这不能解释成校方尚未公布。",
            "source_ids": [
              "UK-SHE-LOOKUP"
            ]
          },
          {
            "label": "校级范围参考",
            "text": "2027/28 新入学国际生非医学、非牙医学本科年费范围为 £27,650–£34,670；这是校级区间，不是该专业报价，不能据此确定全程学费。",
            "source_ids": [
              "UK-SHE-FEES"
            ]
          },
          {
            "label": "后续年度",
            "text": "校方说明：保持同一课程时，之后各年的学费与第一年相同；转专业、实习年及海外学习年另有规则。",
            "source_ids": [
              "UK-SHE-FEES"
            ]
          }
        ],
        "outcomes": [
          {
            "label": "本课程：工作或升学",
            "text": "Discover Uni 的 G402 页面显示，2022/23 届在毕业后 15 个月工作和／或继续学习的比例为 60%；样本 20 人，回应率 70%。该合并指标包含升学，不能读成纯就业率。",
            "source_ids": [
              "UK-SHE-CS-OUTCOMES",
              "UK-DU-METHODS"
            ]
          },
          {
            "label": "学科参考：毕业薪资",
            "text": "该校全日制计算机科学学科的毕业后 15 个月年薪中位数为 £33,000；2021/22–2022/23 两届合并，薪资样本 15 人，页面回应率 70%。这是学科数据，不是 G402 单专业薪资。",
            "source_ids": [
              "UK-SHE-CS-OUTCOMES"
            ]
          },
          {
            "label": "如何理解",
            "text": "以上是历史调查样本，未单列中国大陆学生；样本较小，不能据此推断个人就业概率或预计收入。毕业年、统计范围和是否包含升学应一起阅读。",
            "source_ids": [
              "UK-SHE-CS-OUTCOMES",
              "UK-DU-METHODS"
            ]
          }
        ]
      },
