            "source_ids": [
              "melbourne-overview-agriculture"
            ]
          }
        ],
        "admissions": [
          {
            "label": "资格需用国际生规则",
            "text": "本来源面向澳大利亚及新西兰学生；大陆高考不直接获本科承认的校级规则另列，不能把本指南ATAR、国内补贴或保证入学安排套于中国学生。",
            "source_ids": [
              "melbourne-overview-agriculture"
            ]
          }
        ],
        "applications": [
          {
            "label": "国际申请时间",
