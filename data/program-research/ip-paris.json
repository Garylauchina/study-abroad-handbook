  "profile": {
    "university_id": "ip-paris",
    "checked_at": "2026-09-12",
    "scope": "École Polytechnique Bachelor of Science，共同招生与三双主修；非IP Paris所有成员统一政策",
    "sections": {
      "overview": [
        {
          "label": "同校共用：实际办学单位",
          "text": "本目录是IP Paris成员École Polytechnique开设的Bachelor of Science及三个双主修方向，不能把其他成员的工程师、硕士或博士项目当作这一学位。",
          "source_ids": [
            "ip-paris-central-bachelor"
          ]
        }
      ],
      "admissions": [
        {
          "label": "同校共用：中国高中资格边界",
          "text": "可凭在读或已获、受本国或国际认可的高中毕业/科学类大学入学资格申请；要求高水平数学及至少另一门高水平理科。学校未设统一申请最低总分，但强调优秀成绩和综合选拔；本轮未取得中国高考专门分数或豁免规则。",
          "source_ids": [
            "ip-paris-admissions",
            "ip-paris-faq"
          ]
        },
        {
          "label": "同校共用：英语与法语",
          "text": "IELTS总分6.5、每项6.0，成绩入学时须未满两年；可先申请后补达标英语。无需先懂法语，但毕业须达到法语B2。不接受二、三年级转入。",
          "source_ids": [
            "ip-paris-admissions",
            "ip-paris-faq"
          ]
        }
      ],
      "applications": [
        {
          "label": "同校共用：申请渠道",
          "text": "每学年只可申请一次，选学校在线系统或适用的Parcoursup，不能两边重复；Campus France提交的本学位录取申请不予审查。材料含成绩、动机、CV、证件与两位推荐人，至少一位为当前数学教师；短名单须英文远程面试。",
          "source_ids": [
            "ip-paris-admissions",
            "ip-paris-faq"
          ]
        },
        {
          "label": "下一轮申请日程",
          "text": "官网表列第一轮2026-09-17至10-20 23:59 CEST；第二轮2026-10-21至2027-01-06 23:59 CET；第三轮2027-01-07至02-08 14:00 CET，结果在2027年1—4月。表前仍残留“2026 intakes”，本轮按表内具体日期记录此冲突；2026-09-12尚未开放。",
          "source_ids": [
            "ip-paris-admissions"
          ]
        }
      ],
      "fees": [
        {
          "label": "2027非欧盟学费",
          "text": "FAQ明确2027入学non-EU/non-EEA为EUR19,600/年，专门收费页同额，并说明本学程内学费保持不变。总览页仍列未标年的EUR19,200，不作2027报价；Columbia后续硕士阶段适用其另行收费。",
          "source_ids": [
            "ip-paris-faq",
            "ip-paris-fees",
            "ip-paris-about"
          ]
        },
        {
          "label": "申请费与押金",
          "text": "当前申请费EUR105；FAQ列两笔各EUR1,500不可退押金，可抵首年学费。支付期限按录取后的Enrollment Guidelines，不自行推定。",
          "source_ids": [
            "ip-paris-admissions",
            "ip-paris-faq"
          ]
        },
        {
          "label": "奖助学金条件",
          "text": "学校按成绩和经济需要提供有限资助，建议需资助者优先早轮。Excellence奖学金限with honors录取者，及格进展与良好行为关系续领；国际生可申请校方需求型减免/贷款，不等同自动取得法国CROUS。奖助页还列每年EUR1,500管理费不予减免，是否计入总报价须按账单核对。",
          "source_ids": [
            "ip-paris-funding"
          ]
        }
      ],
      "outcomes": [
        {
          "label": "2022届本科在2025年受访情况",
          "text": "校方2025-12-16报告：2025年2—5月调查2022届79名毕业生，回应率63%，共50名受访者。毕业约30个月时，54%仍学习、36%受雇、2%求职、4%创业、4%其他。此为受访状态分布，包含法国和国际毕业生，不是大陆学生或各双主修的就业率。",
          "source_ids": [
            "ip-paris-survey"
          ]
        },
        {
          "label": "薪资统计边界",
          "text": "同报告已受雇群体跨国平均税前年薪为不含奖金EUR57,000、含奖金EUR74,000；不能当作毕业即刻起薪、全部受访者平均或中国学生预期收入。各双主修独立结果本轮未核实。",
          "source_ids": [
            "ip-paris-survey"
          ]
        }
      ]
    },
