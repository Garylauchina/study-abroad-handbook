      "sections": {
        "overview": [
          {
            "label": "本专业：课程内容",
            "text": "第一年建立数学与科学基础并探索学科，第二、三年选数学搭配物理、计算机或经济的双主修；第三年可交换并完成八周研究实习及论文。",
            "source_ids": [
              "ip-paris-about"
            ]
          },
          {
            "label": "本专业：学位与语言",
            "text": "授予成员为École Polytechnique；完整本科三年、180ECTS，英语教学。后续硕士不是三年本科的一部分。",
            "source_ids": [
              "ip-paris-central-bachelor",
              "ip-paris-about"
            ]
          }
        ],
        "admissions": [],
        "applications": [
          {
            "label": "本专业：共同入口",
            "text": "本条共用Bachelor申请程序；只收一年级申请，后续方向在课程内选择。申请年度与精确轮次见同校共用规则。",
            "source_ids": [
              "ip-paris-admissions"
            ]
          }
        ],
        "fees": [
          {
            "label": "本专业：2027收费",
            "text": "共用本科的2027 non-EU/non-EEA学费EUR19,600/年，奖助学金须另行取得；后续Columbia硕士费用不在此数中。",
            "source_ids": [
              "ip-paris-faq",
              "ip-paris-fees"
            ]
          }
        ],
        "outcomes": [
          {
            "label": "本专业：结果适用范围",
            "text": "已取得2022届整个Bachelor的2025追踪调查，不能把全学位36%受雇状态分布或已就业者跨国薪资当作本双主修的独立统计。",
            "source_ids": [
              "ip-paris-survey"
            ]
          }
        ]
